# Copy to .env and adjust. All values are optional (defaults shown).
BACKEND_PORT=5000

# Database (defaults to a local SQLite file)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/scada_mml
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ProjectTracking
DB_USER=postgres
DB_PASSWORD=P@ssw0rd

# Secrets — CHANGE THESE IN PRODUCTION
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-secret-change-me
JWT_HOURS=12


# CORS: "*" for dev, or a comma-separated allow-list for prod
CORS_ORIGINS=*

# Document uploads (project PDFs). Defaults: backend/docstore, 50 MB per request
# DOCSTORE_DIR=
# MAX_UPLOAD_MB=50
# IMAGESTORE_DIR=

# Behaviour
FLASK_DEBUG=false
SEED_ON_START=false

# Google Sheets integration (optional)
# 1. Enable Sheets API in Google Cloud Console
# 2. Create a Service Account and download the JSON key
# 3. Share the spreadsheet with the service account email
# GOOGLE_SHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms
# GOOGLE_CREDENTIALS_FILE=credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_SHEET_TAB=Projects

# ngrok (public internet access) — https://dashboard.ngrok.com
# NGROK_AUTH_TOKEN=
# NGROK_DOMAIN=
